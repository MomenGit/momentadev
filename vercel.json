{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/momentadev/browser"
      }
    }
  ],
  "routes": [
    {
      "src": "/ar",
      "dest": "/ar/index.html"
    },
    {
      "src": "/ar/(.*)",
      "dest": "/ar/$1"
    },
    {
      "src": "/",
      "dest": "/en/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/en/$1"
    }
  ]
}
